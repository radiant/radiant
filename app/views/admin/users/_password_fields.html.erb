<div data-controller="password-toggle">
  <p data-password-toggle-target="display" style="<%= (@user.new_record? or !@user.valid?) ? "display: none" : nil %>">
    <label><%= t('password') %></label>
    <span class="value">
      &bull;&bull;&bull;&bull;&bull;
      <a class="action" href="#" data-action="password-toggle#showChange"><%= t('change') %></a>
    </span>
  </p>
  <div class="set" data-password-toggle-target="change" style="<%= (!@user.new_record? && @user.valid?) ? "display: none" : nil %>">
    <p>
      <%= f.label :password, t('new_password') %>
      <%= f.password_field "password", :class => "textbox big", :value => "", :size => 15, :maxlength => 40, :autocomplete => 'off' %>
    </p>
    <p>
      <%= f.label :password_confirmation, t('password_confirmation') %>
      <%= f.password_field "password_confirmation", :class => "textbox big", :value => "", :size => 15, :maxlength => 40, :autocomplete => 'off' %>
      <% unless @user.new_record? %>
        <span>
          <%= t('or') %>
          <a href="#" data-action="password-toggle#showDisplay"><%= t('cancel') %></a>
        </span>
      <% end %>
    </p>
  </div>
</div>
