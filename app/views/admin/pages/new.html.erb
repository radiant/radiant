<% render_region :main do |main| %>
  <% main.edit_header do %>
    <h1><%= t('new_page') %></h1>
  <% end %>
  <% main.edit_form do %>
    <%= form_for @page, :as => :page, :url => admin_pages_path, :html => {:id => 'new_page', :multipart => true, 'data-onsubmit_status' => "Creating page&#8230;"} do |f| %>
      <%= render :partial => "fields", :object => f %>
    <% end %>
  <% end %>
  <% main.edit_popups do %>
    <%= render :partial => "popups" %>
  <% end %>
<% end %>

<% content_for :page_scripts, page_edit_javascripts %>
