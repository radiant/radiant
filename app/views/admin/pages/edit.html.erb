<% @page_title = @page.title + ' - ' + default_page_title %>

<% render_region :main do |main| %>
  <% main.edit_header do %>
    <h1><%= t('edit_page') %></h1>
  <% end %>
  <% main.edit_form do %>
    <%= form_for @page, :as => :page, :url => admin_page_path(@page), :html => {:method => :put, :multipart => true, :id => 'edit_page', 'data-onsubmit_status' => t('saving_changes'), 'data-controller' => 'page-editor reference preview', 'data-page-editor-parts-url-value' => admin_page_parts_path, 'data-page-editor-fields-url-value' => admin_page_fields_path, 'data-reference-tags-url-value' => admin_reference_path('tags'), 'data-reference-filters-url-value' => admin_reference_path('filters'), 'data-preview-url-value' => '/admin/pages/preview'} do |fields| %>
      <%= render :partial => "fields", :object => fields %>
    <% end %>
  <% end %>
  <% main.edit_popups do %>
    <%= render :partial => "popups" %>
  <% end %>
<% end %>
