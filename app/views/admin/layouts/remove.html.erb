<h1><%= t('remove_layout') %></h1>

<p><%= t('text.layouts.remove_warning') %></p>

<table class="index" id="layouts">
  <tbody>
    <tr class="node level_1">
      <td class="layout">
        <%= image('layout', :alt => '') %>
        <%= h @layout.name %>
      </td>
    </tr>
  </tbody>
</table>

<%= form_for [:admin, @layout], :html => { :method => 'delete', 'data-onsubmit_status' => "Removing layout&#8230;" } do %>
  <div class="buttons">
    <input class="button" type="submit" value="<%= t('delete_layout') %>" />
    <%= t('or') %>
    <%= link_to t('cancel'), admin_layouts_url %>
  </div>
<% end %>
